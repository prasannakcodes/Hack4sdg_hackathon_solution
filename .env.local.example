# Bhashini AI ULCA Platform Credentials
# Register at https://bhashini.gov.in / https://ulcacontrib.org to generate user credentials
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d7

# If keys are left empty, the prototype gracefully uses the built-in vernacular offline dictionary for Hindi, Tamil, Kannada, Marathi, Gujarati, and English!

# Mapbox Public Access Token (Optional: get your free public token from https://account.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# CARTO Basemaps API Key
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# Supabase Database Configuration (Get from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
